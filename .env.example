# --- Required ---
SURE_URL=https://sure.example.com
SURE_API_KEY=your-sure-api-key
GROQ_API_KEY=your-groq-api-key

# --- Optional ---
# Restrict to one account (default: all accounts)
# SURE_ACCOUNT_ID=
# Groq chat model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Seconds between runs; 0 = run once and exit (default: 3600)
# RUN_INTERVAL_SECONDS=3600
# Transactions per LLM request (default: 25)
# BATCH_SIZE=25
# Only log proposals, do not write back (default: false)
# DRY_RUN=false
# Log level (default: INFO)
# LOG_LEVEL=INFO
